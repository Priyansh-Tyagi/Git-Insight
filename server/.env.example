PORT=4000
NODE_ENV=development

CLIENT_URL=http://localhost:5173

DATABASE_URL=postgres://postgres:postgres@localhost:5432/gitinsight

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback

JWT_SECRET=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# Required for the AI summary feature (Phase 8) and the hallucination experiment.
# Get a key at aistudio.google.com. If unset, the AI summary endpoint returns
# a clear "not configured" error instead of the app failing to start.
GEMINI_API_KEY=
# Optional. Comma-separated, in priority order. If unset, geminiClient.ts
# falls back through a built-in list (Flash-Lite models first, for their
# much higher free-tier daily quota) and automatically skips any model
# that comes back 404 "retired" or 429 "quota exhausted" — Google has
# retired/renamed the free-tier model lineup multiple times in 2026, so
# don't assume a model string you read somewhere is still valid; let the
# fallback chain find a working one. Only set this if you want to force a
# specific model (e.g. you have paid-tier access and always want the same
# one) — see DEFAULT_MODEL_CANDIDATES in geminiClient.ts for the built-in list.
# GEMINI_MODEL_CANDIDATES=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Personal access token (no scopes needed) for scripts/evaluateRubric.ts and
# scripts/runHallucinationExperiment.ts — raises the GitHub API rate limit
# from 60/hr to 5000/hr. Get one at github.com/settings/tokens
EVAL_GITHUB_TOKEN=
